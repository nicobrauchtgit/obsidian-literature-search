    {
      "id": "31effd1fd7ed04da35f1ec0b5e3e5893f11a0899",
      "corpusId": 282139623,
      "title": {
        "text": "David vs. Goliath: A comparative study of different-sized LLMs for code generation in the domain of automotive scenario generation",
        "fragments": [
          {
            "start": 0,
            "end": 5
          },
          {
            "start": 6,
            "end": 8
          },
          {
            "start": 10,
