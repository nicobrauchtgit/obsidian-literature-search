      "title": {
        "text": "David VS Goliath in the food delivery industry: the case of Jafood's strategic path amid multinationals' competition",
        "fragments": [
          {
            "start": 0,
            "end": 5
          },
          {
            "start": 6,
            "end": 8
          },
